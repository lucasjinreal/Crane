_VALID_KINDS = ("tts", "asr", "vad", "llm", "g2p", "vlm", "omni")
_REQUIRED_KEYS = ("repo_id", "dirname", "kind", "description")
for _key, _info in MODELS.items():
    _missing = [k for k in _REQUIRED_KEYS if k not in _info]
    if _missing:
        raise ValueError(f"MODELS[{_key!r}] is missing required key(s): {_missing}")
    if _info["kind"] not in _VALID_KINDS:
        raise ValueError(
            f"MODELS[{_key!r}] has invalid kind {_info['kind']!r}; "
            f"expected one of {_VALID_KINDS}"
        )


def list_models():
    print("Available models:\n")
    width = max(len(key) for key in MODELS)
    for key, info in MODELS.items():
        kind = info["kind"].upper()
        print(f"  {key:<{width}}  [{kind}]  {info['description']}")


def download_github_files(info, local_dir):
    repo = info["github_repo"]
    ref = info["github_ref"]
    base = info.get("github_base", "")
    for repo_path, local_name in info["files"].items():
        full_repo_path = f"{base}/{repo_path}" if base else repo_path
        # Git LFS-tracked files (the .tsv and .onnx here) are stored as
        # pointer text on raw.githubusercontent.com; media.githubusercontent.com
        # resolves the actual LFS object content for both LFS and non-LFS
        # files alike.
        url = f"https://media.githubusercontent.com/media/{repo}/{ref}/{full_repo_path}"
        target = os.path.join(local_dir, local_name)
        os.makedirs(os.path.dirname(target), exist_ok=True)
        print(f"  {url}")
        try:
            with urllib.request.urlopen(url) as response, open(target, "wb") as f:
                shutil.copyfileobj(response, f)
        except urllib.error.HTTPError as e:
            print(f"error: download failed for {url}: {e}", file=sys.stderr)
            sys.exit(1)


def download_model(model_key, path, token, quant):
    info = MODELS[model_key]
    local_dir = os.path.join(os.path.expanduser(path), info["kind"], info["dirname"])

    if info.get("source") == "github":
        print(f"Downloading {info['repo_id']} (GitHub) to {local_dir} ...")
        os.makedirs(local_dir, exist_ok=True)
        download_github_files(info, local_dir)
        print(f"\nDone. Use with: crane-serve --model-path {local_dir}")
        return

    try:
        from huggingface_hub import hf_hub_download, snapshot_download
        from huggingface_hub.utils import HfHubHTTPError
    except ImportError:
        print(
            "error: huggingface_hub is not installed. Install it with:\n\n"
            "    pip install huggingface_hub\n",
            file=sys.stderr,
        )
        sys.exit(1)

    quant_template = info.get("quant_template")

    if quant_template:
        filename = quant_template.format(quant=quant)
        target = os.path.join(local_dir, filename)
        print(f"Downloading {info['repo_id']}:{filename} to {target} ...")
    else:
        target = local_dir
        print(f"Downloading {info['repo_id']} to {local_dir} ...")

    try:
        if quant_template:
            os.makedirs(local_dir, exist_ok=True)
            cached = hf_hub_download(
                repo_id=info["repo_id"], filename=filename, token=token
            )
            shutil.copy2(cached, target)
        else:
            files = info.get("files")
            if files:
                os.makedirs(local_dir, exist_ok=True)
                for repo_path, local_name in files.items():
                    cached = hf_hub_download(
                        repo_id=info["repo_id"], filename=repo_path, token=token
                    )
                    shutil.copy2(cached, os.path.join(local_dir, local_name))
            else:
                snapshot_download(
                    repo_id=info["repo_id"], local_dir=local_dir, token=token
                )

        # Additional files pulled from a *different* repo into the same
        # local_dir (e.g. a pre-converted weight file the primary repo
        # doesn't ship) — downloaded after the primary content above so a
        # failure here doesn't leave the main download half-finished.
        extra_files = info.get("extra_files")
        if extra_files:
            os.makedirs(local_dir, exist_ok=True)
            for extra_repo_id, repo_files in extra_files.items():
                for repo_path, local_name in repo_files.items():
                    print(f"Downloading {extra_repo_id}:{repo_path} ...")
                    cached = hf_hub_download(
                        repo_id=extra_repo_id, filename=repo_path, token=token
                    )
                    shutil.copy2(cached, os.path.join(local_dir, local_name))
    except HfHubHTTPError as e:
        status = e.response.status_code if e.response is not None else None
        print(f"error: download failed: {e}", file=sys.stderr)
        if status in (401, 403):
            print(
                "\nThis model may be gated. Make sure you've accepted its "
                "license on the Hugging Face model page, then pass a valid "
                "--token (or set HF_TOKEN).",
                file=sys.stderr,
            )
        elif status == 404 and quant_template:
            print(
                f"\nNo file named {filename!r} in {info['repo_id']}. Check "
                "the repo's file list on Hugging Face for valid --quant "
                "suffixes (e.g. Q4_K_M, Q5_K_M, Q8_0, UD-Q4_K_XL).",
                file=sys.stderr,
            )
        sys.exit(1)

    print(f"\nDone. Use with: crane-serve --model-path {target}")


def main():
    parser = argparse.ArgumentParser(
        description="Download TTS, ASR, and VAD models for crane-serve from Hugging Face.",
        epilog="examples:\n"
        "  crane-model-download --list\n"
        "  crane-model-download --model voxtral --path /srv/models\n"
        "  crane-model-download --model qwen3-tts-customvoice-1.7b --path ~/models --token hf_...\n"
        "  crane-model-download --model qwen3-asr-0.6b --path ~/models\n"
        "  crane-model-download --model silero-vad --path ~/models\n"
        "  crane-model-download --model qwen3.5-9b-gguf --path ~/models --quant Q8_0\n"
        "  crane-model-download --model moonshine-g2p-en-us --path ~/models\n"
        "  crane-model-download --model kokoro --path ~/models\n",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument(
        "--list", action="store_true", help="List available models and exit"
    )
    group.add_argument(
        "--model", choices=list(MODELS.keys()), help="Model to download"
    )
    parser.add_argument(
        "--path", help="Parent directory to download the model into"
    )
    parser.add_argument(
        "--token",
        help="Hugging Face auth token (prefer the HF_TOKEN env var instead, "
        "to avoid leaking it via shell history or `ps`)",
    )
    parser.add_argument(
        "--quant",
        default="Q4_K_M",
        help="Quantization suffix to download, for GGUF models only "
        "(e.g. Q4_K_M, Q5_K_M, Q8_0, UD-Q4_K_XL). Default: Q4_K_M",
    )
    args = parser.parse_args()

    if args.list:
        list_models()
        return

    if not args.path:
        parser.error("--path is required when using --model")

    download_model(args.model, args.path, args.token, args.quant)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
